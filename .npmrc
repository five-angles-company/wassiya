# React Native cannot use pnpm's default isolated node_modules.
#
# Metro resolves a library's peers from wherever that library physically sits.
# Libraries like react-native-gesture-handler ship a `"react-native":
# "src/index.ts"` entry field, so Metro loads their TypeScript source from
# inside a hashed `.pnpm/<pkg>_<hash>/` directory and then tries to resolve
# `react-native` relative to it. Under the isolated layout that produced six
# separate copies of gesture-handler and two of reanimated in one bundle, which
# breaks module initialisation for the whole app — with no error that points at
# dependencies.
#
# `hoisted` gives the flat, npm-style layout Metro and the React Native
# autolinker expect: exactly one copy of every native singleton.
node-linker=hoisted
