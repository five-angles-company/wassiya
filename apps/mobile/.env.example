# Copy to .env.local and fill in. EXPO_PUBLIC_* vars are embedded in the app
# bundle (public by design) — only put public values here, never CLERK_SECRET_KEY.

# Convex deployment URL (same value as apps/web NEXT_PUBLIC_CONVEX_URL).
EXPO_PUBLIC_CONVEX_URL=

# Clerk publishable key — same one the web app uses.
# https://dashboard.clerk.com/last-active?path=api-keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

