---
import { SITE } from "@/config/site"
import { t, type Locale } from "@/i18n/locale"
import { COMMON } from "@/i18n/strings/common"

interface Props {
  locale: Locale
  class?: string
}

const { locale, class: className } = Astro.props
const common = t(COMMON, locale)

// The stores' own badges, unaltered, at the same height — both stores' brand
// rules forbid redrawing them. Until a listing is live its URL is unset and
// the badge links to `#`.
const badge =
  "lift inline-block rounded-[10px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--ring)]"
---

<div class={`flex flex-wrap items-center gap-3 ${className ?? ""}`}>
  <a href={SITE.appStoreUrl ?? "#"} class={badge} data-track="store_click" data-track-label="ios">
    {/* Apple publishes no Arabic badge we could fetch; swap in the ar-sa one
        from Apple's badge tool when it is to hand. */}
    <img src="/badges/app-store-en.svg" alt={common.appStoreAlt} width="144" height="48" class="h-12 w-auto" />
  </a>
  <a href={SITE.playStoreUrl ?? "#"} class={badge} data-track="store_click" data-track-label="android">
    <img
      src={`/badges/google-play-${locale}.png`}
      alt={common.playStoreAlt}
      width="161"
      height="48"
      class="h-12 w-auto"
    />
  </a>
</div>
