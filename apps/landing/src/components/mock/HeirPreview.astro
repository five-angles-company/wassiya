---
import { File, Mic } from "lucide-react"

import { t, type Locale } from "@/i18n/locale"
import { MOCK } from "@/i18n/strings/mock"

interface Props {
  locale: Locale
}

const m = t(MOCK, Astro.props.locale)
const heirs = [
  { name: m.heirSara, active: false },
  { name: m.heirMohammed, active: true },
  { name: m.heirNoura, active: false },
]
// The app's heir preview: exactly what one heir would receive.
const items = [
  { icon: File, title: m.assetDeed },
  { icon: Mic, title: m.voiceMessage },
]
---

<div>
  <div class="flex flex-wrap gap-1.5">
    {
      heirs.map((heir) => (
        <span
          class:list={[
            "inline-flex items-center gap-1.5 rounded-full border py-1 ps-1 pe-3 text-[12px] font-medium",
            heir.active ? "border-terracotta-700 bg-terracotta-100" : "border-border bg-card",
          ]}
        >
          <span class="bg-olive-200 text-olive-900 flex size-[22px] items-center justify-center rounded-full text-[10px] font-bold">
            {heir.name.charAt(0)}
          </span>
          {heir.name}
        </span>
      ))
    }
  </div>
  <p class="bg-olive-100 text-olive-700 mt-3 rounded-[18px] px-3.5 py-2.5 text-[12px] leading-[1.7]">{m.previewNote}</p>
  <p class="mt-3 text-[13px] font-bold">{m.previewHeading}</p>
  <div class="mt-2 flex flex-col gap-2">
    {
      items.map((item) => (
        <div class="bg-sand-100 flex items-center gap-3 rounded-[20px] p-2.5 shadow-[0_1px_2px_rgb(46_43_37/0.14)]">
          <span class="bg-sand-300 text-sand-800 flex size-10 items-center justify-center rounded-[14px]">
            <item.icon className="size-5" strokeWidth={2.5} aria-hidden="true" />
          </span>
          <span class="flex-1 text-[14px] font-semibold">{item.title}</span>
          <span class="bg-olive-100 text-olive-800 rounded-full px-2.5 py-0.5 text-[10.5px] font-semibold">{m.whole}</span>
        </div>
      ))
    }
  </div>
</div>
