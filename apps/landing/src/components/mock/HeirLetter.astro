---
import { Image } from "astro:assets"
import { File, Landmark, LockKeyhole, Mic } from "lucide-react"

import mark from "@/assets/brand/mark.png"
import { t, type Locale } from "@/i18n/locale"
import { MOCK } from "@/i18n/strings/mock"

interface Props {
  locale: Locale
}

const m = t(MOCK, Astro.props.locale)
// One heir's sealed share, in the recovery sheet's paper: only what was routed
// to her, each item whole.
const items = [
  { icon: File, title: m.assetDeed },
  { icon: Landmark, title: m.assetBank },
  { icon: Mic, title: m.voiceMessage },
]
---

<div class="bg-sand-50 border-border relative rounded-[20px] border p-6 shadow-[var(--shadow-sheet)] md:p-7" aria-hidden="true">
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <Image src={mark} alt="" width={64} height={32} class="h-5 w-auto" />
        <span class="font-heading text-[19px] font-black">{m.letterMasthead}</span>
      </div>
      <p class="text-sand-600 mt-1 text-[10.5px] tracking-[0.14em]" dir="ltr">WASSIYA · SEALED</p>
    </div>
    <span class="bg-primary ring-terracotta-100 flex size-12 shrink-0 items-center justify-center rounded-full text-[#f5ead8] ring-[6px]">
      <LockKeyhole className="size-5" strokeWidth={2.25} aria-hidden="true" />
    </span>
  </div>

  <div class="bg-primary mt-5 h-[2px] rounded-full"></div>

  <p class="text-sand-600 mt-5 text-[11px] font-semibold">{m.letterHeading}</p>
  <div class="mt-2.5 flex flex-col gap-2">
    {
      items.map((item) => (
        <div class="bg-sand-100 flex items-center gap-3 rounded-[16px] p-2.5">
          <span class="bg-sand-300 text-sand-800 flex size-9 items-center justify-center rounded-[12px]">
            <item.icon className="size-[18px]" strokeWidth={2.25} aria-hidden="true" />
          </span>
          <span class="flex-1 text-[14px] font-semibold">{item.title}</span>
          <span class="bg-olive-100 text-olive-800 rounded-full px-2.5 py-0.5 text-[10.5px] font-semibold">{m.whole}</span>
        </div>
      ))
    }
  </div>

  <div class="border-border mt-5 border-t pt-4">
    <p class="text-sand-700 text-[12px] leading-[1.7]">{m.letterFooter}</p>
  </div>
</div>
