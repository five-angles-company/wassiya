---
import { Image } from "astro:assets"

import mark from "@/assets/brand/mark.png"
import { t, type Locale } from "@/i18n/locale"
import { MOCK } from "@/i18n/strings/mock"
import { qrCells } from "@/lib/pattern"

interface Props {
  locale: Locale
}

const m = t(MOCK, Astro.props.locale)
const cells = qrCells()

// The printed sheet's shape (`lib/recovery-sheet-html.ts`), with every code
// group masked: a picture of a recovery code must never look like one.
const lines = ["WSY1 · •••• · ••••", "•••• · •••• · ••••", "•••• · •••• · ••••", "•••• · •••• · ••••", "•••• · •••• · ••••"]
---

<div class="bg-sand-50 border-border relative rounded-[20px] border p-6 shadow-[var(--shadow-sheet)] md:p-7" aria-hidden="true">
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <Image src={mark} alt="" width={64} height={32} class="h-5 w-auto" />
        <span class="font-heading text-[19px] font-black">{m.sheetMasthead}</span>
      </div>
      <p class="text-sand-600 mt-1 text-[10.5px] tracking-[0.14em]" dir="ltr">WASSIYA RECOVERY DOCUMENT</p>
    </div>
    <svg viewBox="0 0 25 25" class="size-16 shrink-0 rounded-[8px] bg-white p-1" shape-rendering="crispEdges">
      {
        cells.flatMap((row, r) =>
          row.map((on, c) => (on ? <rect x={c} y={r} width="1" height="1" fill="#201e1d" /> : null))
        )
      }
    </svg>
  </div>

  <div class="bg-primary mt-5 h-[2px] rounded-full"></div>

  {/* The printed PDF's code panel: a bordered box with the code centred in it.
      The lines are LTR inside an RTL sheet, so left to their own alignment
      they hug one edge and leave the other half of the sheet empty. */}
  <div class="mt-5 rounded-[14px] border-[1.5px] border-[#201e1d]/80 bg-white/60 px-4 pt-3 pb-4">
    <p class="text-sand-600 text-[11px] font-semibold">{m.sheetCodeLabel}</p>
    <div class="mt-2 text-center font-mono text-[16px] leading-[1.9] font-semibold tracking-[0.12em] md:text-[17px]">
      {lines.map((line) => <p dir="ltr">{line}</p>)}
    </div>
  </div>

  <div class="border-border mt-5 border-t pt-4">
    <p class="text-sand-700 text-[12px] leading-[1.7]">{m.sheetFooter}</p>
  </div>
</div>
