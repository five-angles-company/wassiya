---
import { Bitcoin, EyeOff, Landmark, NotebookPen } from "lucide-react"

import Faces from "@/components/ui/Faces.astro"
import { t, type Locale } from "@/i18n/locale"
import { MOCK } from "@/i18n/strings/mock"

interface Props {
  locale: Locale
}

const m = t(MOCK, Astro.props.locale)
const executor = m.executorName.charAt(0)

// The app's `VaultRow`: type icon on a sand disc, the handover choice as one
// line of text.
const rows = [
  { icon: Bitcoin, title: m.assetCrypto, handedOver: true },
  { icon: Landmark, title: m.assetBank, handedOver: true },
  { icon: NotebookPen, title: m.assetDiary, handedOver: false },
]
---

<div class="flex flex-col gap-[9px]">
  {
    rows.map((row) => (
      <div class="bg-card border-border flex items-center gap-3 rounded-[22px] border px-4 py-3">
        <span class="bg-sand-300 text-sand-900 flex size-9 shrink-0 items-center justify-center rounded-full">
          <row.icon className="size-[18px]" strokeWidth={2.5} aria-hidden="true" />
        </span>
        <span class="min-w-0 flex-1">
          <span class="block truncate text-[14px] font-semibold">{row.title}</span>
          <span
            class:list={[
              "block truncate text-[12px]",
              row.handedOver ? "text-olive-700 font-semibold" : "text-muted-foreground",
            ]}
          >
            {row.handedOver ? m.handedOver : m.keptPrivate}
          </span>
        </span>
        {row.handedOver ? (
          <Faces initials={[executor]} size={28} />
        ) : (
          <span class="bg-sand-200 text-sand-600 flex size-7 shrink-0 items-center justify-center rounded-full">
            <EyeOff className="size-3.5" strokeWidth={2.5} aria-hidden="true" />
          </span>
        )}
      </div>
    ))
  }
</div>
