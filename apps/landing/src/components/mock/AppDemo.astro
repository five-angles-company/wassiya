---
import { Bell, Check, ChevronRight, FingerprintPattern, Heart, House, Lock, Settings, Users, Wallet } from "lucide-react"

import ExecutorCard from "@/components/mock/ExecutorCard.astro"
import StatusBar from "@/components/mock/StatusBar.astro"
import VaultRows from "@/components/mock/VaultRows.astro"
import { t, type Locale } from "@/i18n/locale"
import { COMMON } from "@/i18n/strings/common"
import { MOCK } from "@/i18n/strings/mock"
import { fmtNumber } from "@/lib/format"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const m = t(MOCK, locale)
const common = t(COMMON, locale)

// The app's Home, Vault and Executors tabs, drawn to `ScreenHeader`,
// `CheckInHero`, `SettingsRow` and `VaultRow`. `scripts/app-demo.ts` makes the
// tabs and the check-in work; without it this is the Home screen, still.
//
// ⚠️ The check-in only confirms after the fingerprint prompt, as in the app: a
// tap alone never says "still alive", and the demo must not teach otherwise.
const rows = [
  { icon: Wallet, label: m.rowAssets, value: fmtNumber(12, locale) },
  { icon: Users, label: m.rowExecutors, value: fmtNumber(1, locale) },
  { icon: Lock, label: m.rowPrivate, value: fmtNumber(2, locale) },
]
const tabs = [
  { key: "home", icon: House, label: m.tabHome },
  { key: "vault", icon: Wallet, label: m.tabVault },
  { key: "executors", icon: Users, label: m.tabExecutors },
] as const
const title = "font-heading text-[28px] leading-[1.25] font-extrabold"
---

<div data-demo class="bg-background text-foreground relative flex h-full flex-col" dir={locale === "ar" ? "rtl" : "ltr"}>
  <StatusBar locale={locale} />

  <div class="relative flex-1 overflow-hidden px-5 pt-4">
    <section data-demo-screen="home">
      <div class="flex items-center gap-3">
        <div class="min-w-0 flex-1">
          <p class="text-muted-foreground mb-1 text-[11.5px] leading-[1.45]">{m.greeting}</p>
          <p class={title}>{m.ownerName}</p>
        </div>
        <span class="bg-card flex size-10 shrink-0 items-center justify-center rounded-full">
          <Bell className="size-[19px]" strokeWidth={2.75} aria-hidden="true" />
        </span>
      </div>

      <div
        data-demo-checkin
        data-state="ask"
        class="group/checkin bg-terracotta-100 data-[state=confirmed]:bg-olive-100 mt-6 rounded-[28px] px-5 pt-6 pb-5 text-center transition-colors duration-500"
      >
        <div class="relative mx-auto size-[60px]">
          <span class:list={["pulse-ring bg-terracotta-300 absolute inset-0 rounded-full", "group-data-[state=confirmed]/checkin:hidden"]}></span>
          <span
            class:list={[
              "bg-primary relative flex size-full items-center justify-center rounded-full shadow-[0_3px_10px_rgb(46_43_37/0.16)] transition-colors duration-500",
              "group-data-[state=confirmed]/checkin:bg-olive-700",
            ]}
          >
            <Heart className="size-7 fill-[#fff6f0] text-[#fff6f0]" strokeWidth={2.75} aria-hidden="true" />
          </span>
          <span
            class:list={[
              "bg-olive-700 border-olive-100 absolute -end-1 -bottom-1 hidden size-7 items-center justify-center rounded-full border-[3px] text-[#f5ead8]",
              "group-data-[state=confirmed]/checkin:flex",
            ]}
          >
            <Check className="size-[13px]" strokeWidth={3.5} aria-hidden="true" />
          </span>
        </div>
        <p
          class:list={[
            "font-heading text-terracotta-800 mt-4 text-[24px] leading-[1.25] font-extrabold",
            "group-data-[state=confirmed]/checkin:text-olive-800",
          ]}
          aria-live="polite"
        >
          <span class={"group-data-[state=confirmed]/checkin:hidden"}>{m.askTitle}</span>
          <span class="hidden group-data-[state=confirmed]/checkin:inline">{m.confirmedTitle}</span>
        </p>
        <p class:list={["text-terracotta-700 mt-1.5 text-[14.5px] leading-[1.7]", "group-data-[state=confirmed]/checkin:text-olive-700"]}>
          <span class={"group-data-[state=confirmed]/checkin:hidden"}>{m.askBody}</span>
          <span class="hidden group-data-[state=confirmed]/checkin:inline">{m.confirmedBody}</span>
        </p>
        <button
          type="button"
          data-demo-confirm
          data-track="demo_checkin"
          class:list={[
            "bg-primary mt-5 flex h-14 w-full cursor-pointer items-center justify-center gap-2.5 rounded-full text-[#f5ead8] transition-colors duration-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--ring)]",
            "group-data-[state=confirmed]/checkin:bg-olive-700",
          ]}
        >
          <FingerprintPattern className="size-5" strokeWidth={2.75} aria-hidden="true" />
          <span class="text-[14.5px] font-bold">{m.askCta}</span>
        </button>
        <p class:list={["text-terracotta-700 mt-3.5 py-1 text-[11.5px] font-semibold", "group-data-[state=confirmed]/checkin:text-olive-700"]}>
          {m.askSettings}
        </p>
      </div>

      <p class="text-olive-700 mt-6 text-[13.5px] font-bold">{m.allReady}</p>
      <div class="bg-card mt-2 overflow-hidden rounded-[26px]">
        {
          rows.map((row, index) => (
            <div>
              <div class="flex items-center gap-3 px-4 py-3.5">
                <row.icon className="text-muted-foreground size-[18px] shrink-0" strokeWidth={2} aria-hidden="true" />
                <span class="min-w-0 flex-1 text-[14.5px] leading-[1.35] font-semibold">{row.label}</span>
                <span class="text-muted-foreground text-[12.5px]">{row.value}</span>
                <ChevronRight className="text-muted-foreground size-4 shrink-0 rtl:-scale-x-100" strokeWidth={2} aria-hidden="true" />
              </div>
              {index < rows.length - 1 ? <div class="bg-border mx-4 h-px" /> : null}
            </div>
          ))
        }
      </div>
    </section>

    <section data-demo-screen="vault" hidden>
      <p class:list={[title, "mb-6"]}>{m.vaultTitle}</p>
      <VaultRows locale={locale} />
    </section>

    <section data-demo-screen="executors" hidden>
      <p class:list={[title, "mb-6"]}>{m.executorsTitle}</p>
      <ExecutorCard locale={locale} />
    </section>
  </div>

  <div class="bg-sand-100 grid h-[83px] shrink-0 grid-cols-4 border-t border-[rgb(32_30_29/0.16)] pt-2">
    {
      tabs.map((tab) => (
        <button
          type="button"
          data-demo-tab={tab.key}
          data-active={String(tab.key === "home")}
          data-track="demo_tab"
          data-track-label={tab.key}
          class="group flex cursor-pointer flex-col items-center gap-1 focus-visible:outline-none"
        >
          <span class="text-muted-foreground group-data-[active=true]:bg-primary flex h-7 w-12 items-center justify-center rounded-full group-focus-visible:outline-2 group-focus-visible:outline-[color:var(--ring)] group-data-[active=true]:text-[#f5ead8]">
            <tab.icon className="size-[19px]" strokeWidth={2.25} aria-hidden="true" />
          </span>
          <span class="text-muted-foreground group-data-[active=true]:text-primary text-[12px] group-data-[active=true]:font-semibold">
            {tab.label}
          </span>
        </button>
      ))
    }
    <div class="flex flex-col items-center gap-1" aria-hidden="true">
      <span class="text-muted-foreground flex h-7 w-12 items-center justify-center rounded-full">
        <Settings className="size-[19px]" strokeWidth={2} />
      </span>
      <span class="text-muted-foreground text-[12px]">{m.tabAccount}</span>
    </div>
  </div>

  <div data-demo-sheet hidden class="absolute inset-0 z-10 flex flex-col justify-end">
    <button type="button" data-demo-cancel tabindex="-1" aria-hidden="true" class="absolute inset-0 cursor-default bg-[#1c1a19]/45"></button>
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="app-demo-prompt"
      class="bg-card relative rounded-t-[34px] px-6 pt-7 pb-9 text-center"
    >
      <p class="font-heading text-[19px] font-extrabold">{common.appName}</p>
      <p id="app-demo-prompt" class="text-muted-foreground mt-1 text-[14.5px] leading-[1.6]">{m.promptBody}</p>
      <button
        type="button"
        data-demo-touch
        data-state="idle"
        aria-label={m.promptTouch}
        class="group/sensor bg-terracotta-100 text-terracotta-700 data-[state=ok]:bg-olive-100 data-[state=ok]:text-olive-700 mx-auto mt-6 flex size-24 cursor-pointer items-center justify-center rounded-full transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--ring)]"
      >
        <FingerprintPattern className="size-12 group-data-[state=ok]/sensor:hidden" strokeWidth={1.75} aria-hidden="true" />
        <Check className="hidden size-12 group-data-[state=ok]/sensor:block" strokeWidth={2.5} aria-hidden="true" />
      </button>
      <p class="text-muted-foreground mt-3 text-[13px]">{m.promptTouch}</p>
      <button type="button" data-demo-cancel class="text-primary mt-5 cursor-pointer text-[15px] font-semibold">
        {m.promptCancel}
      </button>
    </div>
  </div>
</div>

<script>
  import "@/scripts/app-demo"
</script>
