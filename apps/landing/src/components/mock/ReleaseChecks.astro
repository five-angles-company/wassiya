---
import { Check, PackageOpen } from "lucide-react"

import { t, type Locale } from "@/i18n/locale"
import { MOCK } from "@/i18n/strings/mock"

interface Props {
  locale: Locale
}

const m = t(MOCK, Astro.props.locale)
const checks = [m.checkCertificate, m.checkReview, m.checkVeto, m.checkIdentity]
---

<div class="flex flex-col gap-2">
  {
    checks.map((check) => (
      <div class="bg-card border-border flex items-center justify-between gap-3 rounded-[18px] border px-4 py-2.5">
        <span class="text-[14px] font-semibold">{check}</span>
        <span class="bg-olive-200 text-olive-900 flex size-6 items-center justify-center rounded-full">
          <Check className="size-3.5" strokeWidth={3.25} aria-hidden="true" />
        </span>
      </div>
    ))
  }
  <div class="bg-brand flex items-center justify-between gap-3 rounded-[18px] px-4 py-3 text-white">
    <span class="text-[14.5px] font-bold">{m.checkDone}</span>
    <PackageOpen className="size-5" strokeWidth={2.25} aria-hidden="true" />
  </div>
</div>
