---
import { t, type Locale } from "@/i18n/locale"
import { MOCK } from "@/i18n/strings/mock"

interface Props {
  locale: Locale
}

const m = t(MOCK, Astro.props.locale)
---

<div class="flex h-[54px] shrink-0 items-center justify-between px-9 pt-1.5 text-[16px] font-semibold" aria-hidden="true">
  <span dir="ltr">{m.time}</span>
  <span class="flex items-center gap-1.5" dir="ltr">
    <svg width="18" height="12" viewBox="0 0 18 12" fill="currentColor">
      <rect x="0" y="8" width="3" height="4" rx="1"></rect>
      <rect x="5" y="5.5" width="3" height="6.5" rx="1"></rect>
      <rect x="10" y="3" width="3" height="9" rx="1"></rect>
      <rect x="15" y="0" width="3" height="12" rx="1"></rect>
    </svg>
    <svg width="16" height="12" viewBox="0 0 16 12" fill="currentColor">
      <path d="M8 2.2c2.3 0 4.4.9 6 2.4l1.2-1.3A10.4 10.4 0 0 0 8 .5 10.4 10.4 0 0 0 .8 3.3L2 4.6a8.6 8.6 0 0 1 6-2.4Zm0 3.5c1.4 0 2.6.5 3.6 1.4l1.2-1.3A7 7 0 0 0 8 4a7 7 0 0 0-4.8 1.8l1.2 1.3c1-.9 2.2-1.4 3.6-1.4Zm0 3.4c-.6 0-1.1.2-1.5.6L8 11.5l1.5-1.8c-.4-.4-.9-.6-1.5-.6Z"></path>
    </svg>
    <svg width="27" height="13" viewBox="0 0 27 13" fill="none">
      <rect x=".5" y=".5" width="23" height="12" rx="3.5" stroke="currentColor" opacity=".4"></rect>
      <rect x="2" y="2" width="20" height="9" rx="2" fill="currentColor"></rect>
      <path d="M25 4.5v4c.8-.3 1.3-1.1 1.3-2s-.5-1.7-1.3-2Z" fill="currentColor" opacity=".45"></path>
    </svg>
  </span>
</div>
