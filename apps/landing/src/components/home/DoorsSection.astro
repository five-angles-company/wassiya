---
import { HeartHandshake, MailOpen, ShieldAlert } from "lucide-react"

import ButtonLink from "@/components/ButtonLink.astro"
import SectionHead from "@/components/ui/SectionHead.astro"
import { HOME } from "@/i18n/strings/home"
import { t, webUrl, type Locale } from "@/i18n/locale"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const home = t(HOME, locale)
---

<section id="families" class="mx-auto w-full max-w-[1200px] px-4 py-24 md:px-8 lg:py-28">
  <SectionHead eyebrow={home.doorsEyebrow} title={home.doorsTitle} />

  <div class="mt-12 grid gap-5 md:grid-cols-2 lg:mt-16">
    <article class="rise-in bg-card border-border flex flex-col items-start rounded-[32px] border p-7 md:p-9">
      <span class="bg-terracotta-100 text-terracotta-700 flex size-14 items-center justify-center rounded-2xl">
        <HeartHandshake className="size-7" strokeWidth={1.75} aria-hidden="true" />
      </span>
      <h3 class="mt-6 text-[24px]">{home.doorClaimTitle}</h3>
      <p class="text-sand-700 mt-3 text-[16px] leading-[1.9]">{home.doorClaimBody}</p>
      <p class="text-sand-700 mt-4 text-[13.5px] font-semibold">{home.doorClaimMeta}</p>
      <div class="mt-auto pt-8">
        <ButtonLink href={webUrl(locale, "/file")} variant="outline" data-track="report_death_click">
          {home.doorClaimAction}
        </ButtonLink>
      </div>
    </article>

    <article class="rise-in bg-card border-border flex flex-col items-start rounded-[32px] border p-7 md:p-9">
      <span class="bg-olive-100 text-olive-800 flex size-14 items-center justify-center rounded-2xl">
        <MailOpen className="size-7" strokeWidth={1.75} aria-hidden="true" />
      </span>
      <h3 class="mt-6 text-[24px]">{home.doorHeirTitle}</h3>
      <p class="text-sand-700 mt-3 text-[16px] leading-[1.9]">{home.doorHeirBody}</p>
      <p class="bg-terracotta-100 text-terracotta-800 mt-5 flex items-start gap-3 rounded-[18px] px-4 py-3 text-[14.5px] leading-[1.7] font-semibold">
        <ShieldAlert className="mt-0.5 size-5 shrink-0" strokeWidth={2.25} aria-hidden="true" />
        {home.doorHeirWarning}
      </p>
      <div class="mt-auto pt-8">
        <ButtonLink href={webUrl(locale, "/help")} variant="outline" data-track="heir_help_click">
          {home.doorHeirAction}
        </ButtonLink>
      </div>
    </article>
  </div>
</section>
