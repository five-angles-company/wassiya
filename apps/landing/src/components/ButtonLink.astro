---
import type { HTMLAttributes } from "astro/types"

import {
  buttonClasses,
  type ButtonSize,
  type ButtonVariant,
} from "@workspace/ui/lib/wassiya-button"

interface Props extends Omit<HTMLAttributes<"a">, "class"> {
  href: string
  variant?: ButtonVariant
  size?: ButtonSize
  class?: string
}

const { variant = "primary", size = "md", class: className, ...rest } = Astro.props
---

<a class={`${buttonClasses(variant, size)} ${className ?? ""}`} {...rest}><slot /></a>
