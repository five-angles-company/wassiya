---
interface Props {
  /** What a screen reader hears for the phone as a whole. */
  label: string
  class?: string
}

const { label, class: className } = Astro.props
---

{/* The screen is drawn at the app's 390 × 845 point size and scaled into the
    frame with `zoom`: 254 and 294 are the frame's inner widths below and above
    `md`. `zoom`, not `transform`, so taps land where they are drawn. */}
<figure
  class={`relative mx-auto w-[272px] rounded-[48px] bg-[#1c1a19] p-[9px] shadow-[0_40px_80px_-24px_rgb(32_30_29/0.45),0_0_0_1px_rgb(32_30_29/0.08)] md:w-[312px] ${className ?? ""}`}
>
  <div class="bg-background relative aspect-[390/845] overflow-hidden rounded-[39px]">
    <div role="group" aria-label={label} class="h-[845px] w-[390px] [zoom:0.651] md:[zoom:0.754]">
      <slot />
    </div>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute top-[11px] left-1/2 h-[26px] w-[92px] -translate-x-1/2 rounded-full bg-[#1c1a19]"
    ></span>
  </div>
</figure>
