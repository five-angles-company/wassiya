---
import { Image } from "astro:assets"

import mark from "@/assets/brand/mark.png"
import { SITE } from "@/config/site"
import { COMMON } from "@/i18n/strings/common"
import { fill, other, pathFor, stripLocale, t, webUrl, type Locale } from "@/i18n/locale"
import { fmtDigits } from "@/lib/format"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const common = t(COMMON, locale)
const home = pathFor(locale, "/")
const yearLabel = fmtDigits(String(new Date().getFullYear()), locale)

const columns = [
  {
    title: common.footerProduct,
    links: [
      { href: `${home}#how`, label: common.navHow },
      { href: `${home}#security`, label: common.navSecurity },
      { href: `${home}#plans`, label: common.navPlans },
      { href: `${home}#faq`, label: common.navFaq },
    ],
  },
  {
    title: common.footerHelp,
    links: [
      { href: webUrl(locale, "/file"), label: common.reportDeath, accent: true },
      { href: webUrl(locale, "/help"), label: common.help },
    ],
  },
  {
    title: common.footerLegal,
    links: [
      { href: pathFor(locale, "/legal/terms"), label: common.terms },
      { href: pathFor(locale, "/legal/privacy"), label: common.privacy },
      { href: pathFor(locale, "/legal/encryption"), label: common.encryption },
    ],
  },
]
const link = "text-sand-300 hover:text-sand-50 text-[14.5px] transition-colors"
const accentLink = "text-terracotta-300 hover:text-terracotta-200 text-[14.5px] font-semibold transition-colors"
---

<footer class="grain text-sand-50 relative overflow-hidden rounded-t-[40px] bg-[#1c1a19]">
  <div
    class="mx-auto grid w-full max-w-[1200px] gap-10 px-4 pt-14 pb-10 md:px-8 lg:grid-cols-[minmax(0,1.4fr)_repeat(3,minmax(0,1fr))] lg:gap-10 lg:pt-16"
  >
    <div class="max-w-sm">
      <a href={home} class="inline-flex items-center gap-2.5">
        <Image src={mark} alt="" width={112} height={56} class="h-7 w-auto" />
        <span class="font-heading text-[19px] font-black">{common.appName}</span>
      </a>
      <p class="text-sand-300 mt-5 text-[14.5px] leading-[1.85]">{common.footerPromise}</p>
      <a
        href={pathFor(other(locale), stripLocale(Astro.url.pathname))}
        hreflang={other(locale)}
        lang={other(locale)}
        class="hover:bg-white/[0.08] mt-6 inline-flex h-9 items-center rounded-full border border-white/15 px-4 text-[13.5px] font-semibold transition-colors"
      >
        {common.switchLanguage}
      </a>
    </div>

    <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:col-span-3 lg:gap-10">
      {
        columns.map((column) => (
          <nav aria-label={column.title}>
            <p class="text-sand-400 text-[13px] font-semibold">{column.title}</p>
            <ul class="mt-4 flex flex-col gap-3">
              {column.links.map((item) => (
                <li>
                  <a href={item.href} class={"accent" in item && item.accent ? accentLink : link}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class="mx-auto w-full max-w-[1200px] px-4 md:px-8">
    <div
      class="text-sand-400 flex flex-col gap-2 border-t border-white/10 py-6 text-[13px] leading-[1.8] md:flex-row md:items-center md:justify-between md:gap-8"
    >
      <p>{common.notLegal}</p>
      <div class="flex shrink-0 items-center gap-6">
        {
          SITE.gaId && (
            <button type="button" data-consent-open class="hover:text-sand-50 cursor-pointer transition-colors">
              {common.cookieSettings}
            </button>
          )
        }
        <p>{fill(common.copyright, { year: yearLabel })}</p>
      </div>
    </div>
  </div>
</footer>
