---
import "../styles/global.css"

import { SiteFooter } from "@workspace/ui/components/site/site-footer"
import { SiteHeader } from "@workspace/ui/components/site/site-header"
import { SITE_NAV_LINK, siteCopy } from "@workspace/ui/lib/site"
import { buttonClasses } from "@workspace/ui/lib/wassiya-button"

import mark from "@/assets/brand/mark.png"
import ConsentBanner from "@/components/ConsentBanner.astro"
import { SITE } from "@/config/site"
import { COMMON } from "@/i18n/strings/common"
import { dirFor, pathFor, stripLocale, t, webUrl, type Locale } from "@/i18n/locale"
import { siteHrefs } from "@/lib/site-hrefs"

interface Props {
  locale: Locale
  title: string
  description: string
  noindex?: boolean
}

const { locale, title, description, noindex = false } = Astro.props
const common = t(COMMON, locale)
const bare = stripLocale(Astro.url.pathname)
const canonical = new URL(pathFor(locale, bare), Astro.site)
const alternate = (to: Locale) => new URL(pathFor(to, bare), Astro.site).href
const ogImage = new URL(`/og/${locale}.png`, Astro.site).href
const hrefs = siteHrefs(locale, Astro.url.pathname)
const copy = siteCopy(locale)
const nav = [
  { href: hrefs.how, label: copy.navHow },
  { href: hrefs.security, label: copy.navSecurity },
  { href: hrefs.plans, label: copy.navPlans },
  { href: hrefs.faq, label: copy.navFaq },
  { href: hrefs.help, label: copy.help },
]
---

<!doctype html>
<html lang={locale} dir={dirFor(locale)} class="wassiya">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5ead8" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="ar" href={alternate("ar")} />
    <link rel="alternate" hreflang="en" href={alternate("en")} />
    <link rel="alternate" hreflang="x-default" href={alternate("ar")} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={common.appName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === "ar" ? "ar_SA" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />

    {SITE.appStoreId && <meta name="apple-itunes-app" content={`app-id=${SITE.appStoreId}`} />}
  </head>
  <body class="min-h-svh antialiased">
    <a
      href="#main"
      class="bg-primary text-primary-foreground sr-only z-50 rounded-full px-4 py-2 font-semibold focus:not-sr-only focus:absolute focus:start-4 focus:top-4"
    >
      {common.skipToContent}
    </a>
    <SiteHeader locale={locale} hrefs={hrefs} markSrc={mark.src}>
      <Fragment slot="nav">
        {nav.map((item) => <a href={item.href} class={SITE_NAV_LINK}>{item.label}</a>)}
      </Fragment>
      {/* The web app's front page, which asks for sign-in when needed; the
          label follows the visitor's session (`scripts/signed-in.ts`). */}
      <a slot="actions" href={webUrl(locale, "/")} class={`${buttonClasses("primary", "sm")} h-10 px-5`} data-track="account_click">
        <span data-account-label="signed-out">{copy.signIn}</span>
        <span data-account-label="signed-in" hidden>{copy.myReports}</span>
      </a>
    </SiteHeader>
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} hrefs={hrefs} markSrc={mark.src} cookieSettings={SITE.gaId !== undefined} />
    {SITE.gaId && <ConsentBanner locale={locale} gaId={SITE.gaId} />}
    <script>
      import "@/scripts/signed-in"
    </script>
  </body>
</html>
