# Build-time only. Astro inlines every PUBLIC_* value into the static HTML, so
# nothing here may be a secret. Unset values degrade, they never break the build.

# The web app (death reports, executors, /help). Defaults to http://localhost:3001.
PUBLIC_WEB_URL=

# Store listings. Unset → the store badges link to "#".
PUBLIC_APP_STORE_URL=
PUBLIC_PLAY_STORE_URL=
# Numeric App Store id, for Safari's smart app banner.
PUBLIC_APP_STORE_ID=

# The Convex deployment the plan limits and prices are read from
# (`plans.published`): at build time, and again in the browser on every visit.
# Unset → the Plans section says the limits in words and shows no price.
PUBLIC_CONVEX_URL=

# GA4 measurement id (G-XXXXXXX). Unset → no consent banner and no script.
PUBLIC_GA_ID=
