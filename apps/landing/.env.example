# Build-time only. Astro inlines every PUBLIC_* value into the static HTML, so
# nothing here may be a secret. Unset values degrade, they never break the build.

# The web app (death reports, heirs, /help). Defaults to http://localhost:3001.
PUBLIC_WEB_URL=

# Store listings. Unset → the badges render as "coming soon".
PUBLIC_APP_STORE_URL=
PUBLIC_PLAY_STORE_URL=
# Numeric App Store id, for Safari's smart app banner.
PUBLIC_APP_STORE_ID=

# The Convex deployment the plan limits are read from at build time
# (`plans.published`). Unset or unreachable → the Plans section drops the
# numbers and keeps the sentence.
PUBLIC_CONVEX_URL=

# GA4 measurement id (G-XXXXXXX). Unset → no consent banner and no script.
PUBLIC_GA_ID=
