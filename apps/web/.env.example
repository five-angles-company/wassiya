# Copy to .env.local and fill in. .env.local is gitignored.
# See the root README "Bootstrapping" section for where each value comes from.

# Convex deployment URL for the browser client (same deployment as the backend).
NEXT_PUBLIC_CONVEX_URL=

# --- Clerk (server + client) ---
# Both from https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Keep sign-in/sign-up on the in-app pages (app/sign-in, app/sign-up) instead of
# redirecting to Clerk's hosted Account Portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
