{
  "name": "@workspace/backend",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "convex dev",
    "setup": "convex dev --until-success",
    "typecheck": "tsc --noEmit -p convex",
    "verify": "node scripts/verify-invariants.mjs",
    "test": "node scripts/verify-invariants.mjs && vitest run"
  },
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    }
  },
  "dependencies": {
    "@clerk/backend": "^3.16.10",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "^0.2.8",
    "@workspace/crypto": "workspace:*",
    "convex": "^1.44.0",
    "svix": "^2.0.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^20",
    "@workspace/typescript-config": "workspace:*",
    "convex-test": "^0.0.59",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
