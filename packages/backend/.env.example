# This file is written automatically by `npx convex dev` — you normally do NOT
# edit it by hand. It is shown here only to document what ends up in
# packages/backend/.env.local. .env.local is gitignored.

# Set by `convex dev`:
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# No Clerk vars belong in this file. The Convex *deployment* env is a separate
# store, and it is where Clerk's values must go:
#   CLERK_FRONTEND_API_URL        (for convex/auth.config.ts — from
#                                  https://dashboard.clerk.com/apps/setup/convex)
#   CLERK_WEBHOOK_SIGNING_SECRET  (for convex/http.ts — the webhook's signing secret)
# Set both with `npx convex env set …`; verify with `npx convex env list`.
